# Support CRM — environment variables (copy to .env and fill in)
# Used by config.py ONLY when config/db_config.json does not exist.
# config/db_config.json (created by the configurator) takes precedence.

# MariaDB / MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=supportcrm

# UI language: el (Greek) or en (English)
DEFAULT_LANGUAGE=el

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
