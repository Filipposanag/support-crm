/* Support CRM - Modern Flat Design Stylesheet */

/* ============================================
   COLOR PALETTE
   ============================================ */
/* Primary Colors */
/* --primary: #2196F3 (Blue) */
/* --primary-dark: #1976D2 */
/* --primary-light: #BBDEFB */

/* Secondary Colors */
/* --secondary: #4CAF50 (Green) */
/* --secondary-dark: #388E3C */

/* Neutral Colors */
/* --background: #FAFAFA */
/* --surface: #FFFFFF */
/* --border: #E0E0E0 */
/* --text-primary: #212121 */
/* --text-secondary: #757575 */

/* Status Colors */
/* --success: #4CAF50 */
/* --warning: #FF9800 */
/* --error: #F44336 */
/* --info: #2196F3 */


/* ============================================
   MAIN WINDOW
   ============================================ */
QMainWindow {
    background-color: #FAFAFA;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #212121;
}


/* ============================================
   SIDEBAR NAVIGATION
   ============================================ */
QListWidget, QListView {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    padding: 12px 16px;
    border-radius: 4px;
    margin: 2px 0px;
}

QListWidget::item:selected {
    background-color: #2196F3;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background-color: #BBDEFB;
}

QListWidget::item:selected:hover {
    background-color: #1976D2;
}


/* ============================================
   TABLES
   ============================================ */
QTableView {
    background-color: #FFFFFF;
    color: #212121;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    gridline-color: #E0E0E0;
    selection-background-color: #BBDEFB;
    selection-color: #212121;
    outline: none;
}

QTableView::item {
    padding: 6px;
}

QTableView::item:selected {
    background-color: #BBDEFB;
    color: #212121;
}

QTableView::item:hover {
    background-color: #E3F2FD;
}

/* Reset QCalendarWidget QTableView to default - prevent styling conflicts */
QCalendarWidget QTableView {
    background-color: #FFFFFF;
    color: #212121;
    border: none;
    border-radius: 0px;
    gridline-color: #E0E0E0;
    selection-background-color: #2196F3;
    selection-color: #FFFFFF;
}

QCalendarWidget QTableView::item {
    padding: 0px;
    color: #212121;
}

QCalendarWidget QTableView::item:selected {
    background-color: #2196F3;
    color: #FFFFFF;
}

QCalendarWidget QTableView::item:hover {
    background-color: #E3F2FD;
}

QHeaderView::section {
    background-color: #F5F5F5;
    color: #212121;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #2196F3;
    border-right: 1px solid #E0E0E0;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #EEEEEE;
}

/* Reset QCalendarWidget QHeaderView to default */
QCalendarWidget QHeaderView::section {
    background-color: palette(button);
    color: palette(text);
    padding: 3px;
    border: 1px solid palette(mid);
    border-bottom: none;
    font-weight: normal;
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    gridline-color: #E0E0E0;
    outline: none;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #BBDEFB;
    color: #212121;
}


/* ============================================
   BUTTONS
   ============================================ */
QPushButton {
    background-color: #f0f0f0;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 6px 18px;
    font-size: 13px;
    font-weight: 500;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #e0e0e0;
    border-color: #b0b0b0;
}

QPushButton:pressed {
    background-color: #d0d0d0;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #9E9E9E;
    border-color: #e0e0e0;
}

/* Primary Button Style */
QPushButton#primaryButton {
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #0a88e6;
}

QPushButton#primaryButton:pressed {
    background-color: #005a9e;
}

QPushButton#primaryButton:disabled {
    background-color: #E0E0E0;
    color: #9E9E9E;
}

/* Secondary Button Style */
QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #0078D4;
    border: 1px solid #0078D4;
}

QPushButton#secondaryButton:hover {
    background-color: #E3F2FD;
}

QPushButton#secondaryButton:pressed {
    background-color: #BBDEFB;
}

/* Legacy button styles (for backward compatibility) */
QPushButton[buttonStyle="secondary"] {
    background-color: #FFFFFF;
    color: #2196F3;
    border: 1px solid #2196F3;
}

QPushButton[buttonStyle="secondary"]:hover {
    background-color: #E3F2FD;
}

/* Success Button Style */
QPushButton[buttonStyle="success"] {
    background-color: #4CAF50;
}

QPushButton[buttonStyle="success"]:hover {
    background-color: #388E3C;
}

/* Danger Button Style */
QPushButton[buttonStyle="danger"] {
    background-color: #F44336;
}

QPushButton[buttonStyle="danger"]:hover {
    background-color: #D32F2F;
}

/* Warning Button Style */
QPushButton[buttonStyle="warning"] {
    background-color: #FF9800;
}

QPushButton[buttonStyle="warning"]:hover {
    background-color: #F57C00;
}


/* ============================================
   INPUT FIELDS
   ============================================ */
QLineEdit {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    selection-background-color: #BBDEFB;
    min-height: 28px;
}

QLineEdit:focus {
    border: 2px solid #2196F3;
    padding: 5px 9px;
}

QLineEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

/* Validation Error State */
QLineEdit[error="true"] {
    border: 2px solid #F44336;
    padding: 5px 9px;
}

QLineEdit[error="true"]:focus {
    border: 2px solid #F44336;
}

QTextEdit {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 8px;
    background-color: #FFFFFF;
    selection-background-color: #BBDEFB;
}

QTextEdit:focus {
    border: 2px solid #2196F3;
    padding: 7px;
}

QTextEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

QPlainTextEdit {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 8px;
    background-color: #FFFFFF;
    selection-background-color: #BBDEFB;
}

QPlainTextEdit:focus {
    border: 2px solid #2196F3;
    padding: 7px;
}

QPlainTextEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}


/* ============================================
   SPINBOXES AND NUMBER INPUTS
   ============================================ */
/* QSpinBox styling removed - using default Qt/Fusion style for arrows compatibility */


/* ============================================
   DATE AND TIME INPUTS
   ============================================ */
QDateEdit, QTimeEdit, QDateTimeEdit {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    min-height: 28px;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #2196F3;
    padding: 5px 9px;
}

QDateEdit:disabled, QTimeEdit:disabled, QDateTimeEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #E0E0E0;
}

/* QCalendarWidget styling removed - using default Qt behavior for maximum compatibility */


/* ============================================
   COMBOBOX
   ============================================ */
QComboBox {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    min-height: 28px;
}

QComboBox:focus {
    border: 2px solid #2196F3;
    padding: 5px 9px;
}

QComboBox:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #E0E0E0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #757575;
    width: 0px;
    height: 0px;
}

QComboBox QAbstractItemView {
    border: 1px solid #E0E0E0;
    background-color: #FFFFFF;
    selection-background-color: #BBDEFB;
    selection-color: #212121;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 6px 12px;
}


/* ============================================
   CHECKBOXES
   ============================================ */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #757575;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2196F3;
}

QCheckBox::indicator:checked {
    background-color: #2196F3;
    border-color: #2196F3;
    image: none;
}

QCheckBox::indicator:checked:hover {
    background-color: #1976D2;
    border-color: #1976D2;
}

QCheckBox::indicator:disabled {
    border-color: #E0E0E0;
    background-color: #F5F5F5;
}


/* ============================================
   RADIO BUTTONS
   ============================================ */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #757575;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:hover {
    border-color: #2196F3;
}

QRadioButton::indicator:checked {
    background-color: #FFFFFF;
    border-color: #2196F3;
}

QRadioButton::indicator:checked::after {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #2196F3;
}

QRadioButton::indicator:disabled {
    border-color: #E0E0E0;
    background-color: #F5F5F5;
}


/* ============================================
   PROGRESS BAR
   ============================================ */
QProgressBar {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    text-align: center;
    background-color: #F5F5F5;
    color: #212121;
    font-weight: 500;
    min-height: 24px;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 3px;
}

QProgressBar[status="warning"]::chunk {
    background-color: #FF9800;
}

QProgressBar[status="error"]::chunk {
    background-color: #F44336;
}


/* ============================================
   TABS
   ============================================ */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin-right: 2px;
    color: #757575;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #2196F3;
    font-weight: 500;
    border-bottom: 2px solid #2196F3;
}

QTabBar::tab:hover {
    background-color: #E3F2FD;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}


/* ============================================
   SCROLLBARS
   ============================================ */
QScrollBar:vertical {
    border: none;
    background-color: #F5F5F5;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #BDBDBD;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9E9E9E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F5F5F5;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #BDBDBD;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9E9E9E;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}


/* ============================================
   STATUS BAR
   ============================================ */
QStatusBar {
    background-color: #F5F5F5;
    border-top: 1px solid #E0E0E0;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    padding: 2px 8px;
}


/* ============================================
   MENU BAR
   ============================================ */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #E3F2FD;
}

QMenuBar::item:pressed {
    background-color: #BBDEFB;
}


/* ============================================
   MENUS
   ============================================ */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #E3F2FD;
}

QMenu::separator {
    height: 1px;
    background-color: #E0E0E0;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}


/* ============================================
   TOOLBAR
   ============================================ */
QToolBar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E0E0E0;
    spacing: 8px;
    padding: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #E0E0E0;
    margin: 4px 8px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QToolButton:hover {
    background-color: #E3F2FD;
}

QToolButton:pressed {
    background-color: #BBDEFB;
}


/* ============================================
   DIALOGS
   ============================================ */
QDialog {
    background-color: #FAFAFA;
}

QDialogButtonBox {
    button-layout: 0;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}


/* ============================================
   GROUP BOX
   ============================================ */
QGroupBox {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    background-color: #FAFAFA;
    color: #2196F3;
}


/* ============================================
   LABELS
   ============================================ */
QLabel {
    color: #212121;
    background-color: transparent;
}

QLabel[labelStyle="heading"] {
    font-size: 16px;
    font-weight: 600;
    color: #212121;
}

QLabel[labelStyle="subheading"] {
    font-size: 14px;
    font-weight: 500;
    color: #757575;
}

QLabel[labelStyle="error"] {
    color: #F44336;
    font-size: 12px;
}

QLabel[labelStyle="success"] {
    color: #4CAF50;
    font-size: 12px;
}

QLabel[labelStyle="warning"] {
    color: #FF9800;
    font-size: 12px;
}

QLabel[labelStyle="info"] {
    color: #2196F3;
    font-size: 12px;
}


/* ============================================
   SPLITTER
   ============================================ */
QSplitter::handle {
    background-color: #E0E0E0;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #2196F3;
}


/* ============================================
   TOOLTIP
   ============================================ */
QToolTip {
    background-color: #424242;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}


/* ============================================
   FRAME
   ============================================ */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    border: 1px solid #E0E0E0;
}

QFrame[frameStyle="panel"] {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 8px;
}
